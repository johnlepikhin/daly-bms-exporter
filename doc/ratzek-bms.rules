# Canonical copy of the BMS/battery Prometheus alert rules for the ratzek deploy.
#
# Deployed to  ratzek:/etc/prometheus/rules/ratzek-bms.rules
# Kept as a SEPARATE file (not in ratzek-site.rules) so re-deploys of the
# host-managed ratzek-site.rules cannot revert our LTO-specific tuning —
# Prometheus loads every /etc/prometheus/rules/*.rules.
#
# Thresholds reflect deliberate decisions (see memory: lto-inverter-constraints):
#   - DeepDischarge is a BANK total (V*I summed across the 3 parallel packs).
#   - BMSAlarm excludes transient diff_volt_* flags (real imbalance -> CellImbalance).
#   - SOC alerts + ChargingCold are intentionally disabled (SOC unreliable; LTO not LFP).
# This repo copy is the source of truth; sync changes here to the host.
groups:
  - name: ratzek-bms
    rules:
      - alert: RatzekBatteryVoltageLow
        expr: daly_bms_pack_voltage_volts < 22.5
        for: 10m
        labels: { severity: critical }
        annotations:
          summary: "Напряжение АКБ [{{ $labels.battery }}] {{ $value | humanize }} В — пустая батарея / близко отсечка"

      - alert: RatzekBatteryDeepDischarge
        # bank total V*I; strong discharge = 250 W across the parallel bank
        expr: sum(daly_bms_pack_voltage_volts * on(sn) daly_bms_current_amperes) < -250
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Глубокий разряд банка: {{ $value | humanize }} Вт"

      - alert: RatzekBMSAlarm
        # diff_volt_l1/l2 flap transiently → excluded; real imbalance = RatzekBMSCellImbalance
        expr: daly_bms_alarm{type!~"diff_volt.*"} != 0
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Сработала защита BMS [{{ $labels.battery }}]: {{ $labels.type }}"

      - alert: RatzekBMSCommsLost
        expr: time() - daly_bms_last_frame_timestamp_seconds > 3600
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Нет телеметрии BMS [{{ $labels.battery }}] уже {{ $value | humanize }}с — слепы по питанию"

      - alert: RatzekBMSCellImbalance
        expr: daly_bms_cell_voltage_delta_volts > 0.4
        for: 30m
        labels: { severity: warning }
        annotations:
          summary: "Разбаланс ячеек АКБ [{{ $labels.battery }}]: разброс {{ $value | humanize }} В (слабая/деградирующая ячейка)"

      # --- Energy-accounting health (added after the 2026-08-22 phantom spike) ---

      - alert: RatzekBMSEnergyCounterReset
        # The one alert that must not be dropped: the dashboards now clamp
        # per-window increments, so a counter reset no longer shows up as a
        # 20 kWh bar — it is invisible on the graphs. resets() sees the decrease
        # itself, down to the single ULP that caused the original incident.
        # `or`, not `+`: the watt-hour series are minted lazily, so a pack that
        # has only ever charged has no discharge series and `+` (an inner join)
        # would drop it from the result entirely.
        expr: resets(daly_bms_charge_watt_hours_total[1h]) > 0 or resets(daly_bms_discharge_watt_hours_total[1h]) > 0
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Счётчик энергии BMS [{{ $labels.battery }}] уехал вниз — Prometheus засчитает reset и нарисует фантомный скачок"

      - alert: RatzekBMSEnergyAccountingStalled
        # Counters advance only after the state file is durably written, so a
        # broken write freezes energy accounting silently: flat graphs, no error
        # anywhere else. Guarded by frames_decoded so a genuinely offline device
        # does not fire this instead of RatzekBMSCommsLost.
        # `and on()` is load-bearing: the left side is an unlabelled gauge while
        # the right carries `block`, and plain `and` matches on the full label
        # set — the alert would never fire.
        expr: time() - daly_bms_state_last_write_timestamp_seconds > 900 and on() sum(rate(daly_bms_frames_decoded_total[15m])) > 0
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Учёт энергии встал: state-файл не пишется {{ $value | humanize }}с (проверь место на диске и права на /var/lib/daly-bms-exporter)"

      - alert: RatzekBMSStateWriteFailing
        expr: increase(daly_bms_state_write_errors_total[15m]) > 0
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Не пишется state-файл экспортёра (стадия {{ $labels.stage }}) — счётчики энергии заморожены"

      - alert: RatzekBMSImplausibleSamples
        # Either the device/transport is producing garbage, or the plausibility
        # thresholds are too tight. Both are worth looking at; reason= says which.
        # Implausible frames are dropped whole (frames_dropped_total, since
        # 0.1.10); coulomb_samples_rejected_total is left for clamped deltas.
        # The exporter pre-creates every reason series at 0, so increase() sees
        # the very first drop — on 2026-09-21 a 436.6 A frame was rejected and
        # this rule stayed silent because the series was born at 1.
        expr: >
          increase(daly_bms_frames_dropped_total{reason=~"implausible_.*"}[1h]) > 0
          or increase(daly_bms_coulomb_samples_rejected_total[1h]) > 0
        for: 15m
        labels: { severity: info }
        annotations:
          summary: "Кадры BMS не проходят проверку правдоподобности ({{ $labels.reason }}) — мусор от устройства или слишком узкие пороги"

      # --- Current-sensor self-calibration -----------------------------
      # Background: each pack's current register has its own zero-point error.
      # Integrated around the clock it becomes phantom charge — ratzek-2 sat at
      # +150 mA, i.e. 3.6 Ah/day that went "in" and never came out, which is why
      # its energy-in ran 25% ahead of energy-out at a flat SOC. The exporter now
      # estimates that offset from the charge balance and feeds a parallel set of
      # daly_bms_calibrated_* counters; the raw counters are untouched.

      - alert: RatzekBMSCalibrationFrozen
        # The parallel-pack cross-check and the charge balance stopped agreeing,
        # so the correction is pinned at its last good value. Expect a steady
        # ~50 mA gap between the two in normal operation — this fires only well
        # past that, which means a sensor is drifting, a pack has left the bank,
        # or the balancer reading has gone wrong.
        expr: daly_bms_calibration_hold == 4
        for: 6h
        labels: { severity: warning }
        annotations:
          summary: "Калибровка тока [{{ $labels.battery }}] заморожена: параллельные пакеты и баланс заряда разошлись"

      - alert: RatzekBMSCurrentOffsetHigh
        # The correction is doing its job, but a pack needing more than 200 mA of
        # it is a hardware observation worth acting on, not just bookkeeping: at
        # that size the BMS's own SOC estimate is unusable (ratzek-2's pinned at
        # 100% for weeks), and the offset masks how the bank is really loaded.
        expr: abs(daly_bms_current_offset_estimate_amperes) > 0.2
        for: 24h
        labels: { severity: info }
        annotations:
          summary: "Датчик тока [{{ $labels.battery }}] смещён на {{ $value | humanize }} А — SOC этого пакета недостоверен"

      - alert: RatzekBMSCalibrationStalled
        # Warmup is normal and takes ~33 days from scratch on a 40 Ah pack, but
        # the bound falls as 1/window, so after two months it must be well under
        # the threshold. Still held past that means the estimator is not
        # accumulating: frames without remaining capacity, or a gap cap eating
        # the integration time.
        expr: daly_bms_calibration_hold != 0 and daly_bms_calibration_span_hours > 1500
        for: 12h
        labels: { severity: info }
        annotations:
          summary: "Калибровка тока [{{ $labels.battery }}] не включается за {{ $value | humanize }} ч наблюдений — проверь, приходит ли remaining capacity"

      # --- Intentionally DISABLED (do not re-enable without reason) ---
      # RatzekBatterySOCCritical / RatzekBatterySOCLow: BMS SOC is unreliable on this
      #   controller; empty-battery is caught by RatzekBatteryVoltageLow (measured).
      # RatzekBMSChargingCold: LTO (not LFP) tolerates cold charging → false premise.
